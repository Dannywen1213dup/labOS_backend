# Development Environment Variables
# This file contains all configuration for the development Docker Compose setup

# ============================================================================
# Port Configuration
# ============================================================================
NGINX_PORT=8000
FRONTEND_PORT=8080
BACKEND_PORT=8101
MYSQL_PORT=3306
REDIS_PORT=6379
REDIS_INSIGHT_PORT=8001
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ============================================================================
# MySQL Configuration
# ============================================================================
MYSQL_ROOT_PASSWORD=20040812
MYSQL_DATABASE=my_db
MYSQL_USER=labos
MYSQL_PASSWORD=20040812

# ============================================================================
# Redis Configuration
# ============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DATABASE=1

# ============================================================================
# MinIO Configuration
# ============================================================================
MINIO_ROOT_USER=labos
MINIO_ROOT_PASSWORD=labos20040812
MINIO_BUCKET=labos
MINIO_REGION=us-east-1

# ============================================================================
# Backend Spring Boot Configuration
# ============================================================================
SPRING_PROFILES_ACTIVE=dev
SPRING_DEVTOOLS_RESTART_ENABLED=true
SPRING_DEVTOOLS_LIVERELOAD_ENABLED=true

# Spring DataSource (MySQL)
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/my_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=20040812

# Spring Redis
SPRING_REDIS_HOST=redis
SPRING_REDIS_PORT=6379

# AWS S3 / MinIO
AWS_S3_ACCESS_KEY=labos
AWS_S3_SECRET_KEY=labos20040812
AWS_S3_REGION=us-east-1
AWS_S3_BUCKET=labos
AWS_S3_ENDPOINT=http://minio:9000

# ============================================================================
# Frontend Configuration
# ============================================================================
# API Base URL - points to nginx reverse proxy
API_BASE_URL=http://localhost:8000/api

# MinIO public endpoint for browser access (only used when USE_LOCAL_MINIO=true)
AWS_S3_PUBLIC_ENDPOINT=http://localhost:9000
USE_LOCAL_MINIO=true
